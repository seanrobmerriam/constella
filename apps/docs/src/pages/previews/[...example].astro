---
import "@constella/shared/styles/index.css";
import { examples, getExample } from "@constella/shared/examples/index.ts";

export function getStaticPaths() {
  return examples.map((example) => ({ params: { example: example.id } }));
}

const example = getExample(Astro.params.example as string)!;
// The registry is trusted source. Its copyable HTML carries a module script that
// imports the built behavior file; here the same shared behavior is bundled below.
const markup = example.html.replace(/<script[\s\S]*?<\/script>/g, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{example.title} preview</title>
    {example.css && <style set:html={example.css} />}
  </head>
  <body style="padding: 1.5rem" data-behavior={example.behaviorEntry}>
    <Fragment set:html={markup} />
  </body>
</html>

<script>
  import { initAccordion } from "@constella/shared/behaviors/accordion.ts";
  import { initNavbar } from "@constella/shared/behaviors/navbar.ts";
  import { initForm } from "@constella/shared/behaviors/form.ts";
  import { initRange } from "@constella/shared/behaviors/range.ts";
  import { initDropdown } from "@constella/shared/behaviors/dropdown.ts";
  import { initModal } from "@constella/shared/behaviors/modal.ts";
  import { initTabs } from "@constella/shared/behaviors/tabs.ts";
  import { initSlider } from "@constella/shared/behaviors/slider.ts";
  import { initMarquee } from "@constella/shared/behaviors/marquee.ts";
  import { initAlert } from "@constella/shared/behaviors/alert.ts";

  const entry = document.body.dataset.behavior;
  const roots = (selector: string) =>
    document.querySelectorAll<HTMLElement>(selector);
  if (entry === "accordion") roots("[data-accordion]").forEach(initAccordion);
  if (entry === "navbar") roots("[data-navbar]").forEach(initNavbar);
  if (entry === "form") {
    roots(".form_wrap").forEach(initForm);
    roots(".form-range").forEach(initRange);
  }
  if (entry === "range") roots(".form-range").forEach(initRange);
  if (entry === "dropdown")
    document
      .querySelectorAll<HTMLDetailsElement>(".dropdown_wrap")
      .forEach(initDropdown);
  if (entry === "modal")
    document
      .querySelectorAll<HTMLDialogElement>(".modal_wrap")
      .forEach(initModal);
  if (entry === "tabs") roots(".tabs_wrap").forEach(initTabs);
  if (entry === "slider") roots(".slider_wrap").forEach(initSlider);
  if (entry === "marquee") roots(".marquee_wrap").forEach(initMarquee);
  if (entry === "alert") roots(".alert_wrap").forEach(initAlert);
</script>
