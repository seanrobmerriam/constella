---
/**
 * Which files style which component, read from the component manifest
 * (apps/shared/src/manifest.ts). `bun run check:docs` keeps the manifest in
 * step with the source, so this table cannot drift.
 */
import { components } from "@constella/shared/manifest.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const rows = components.filter((c) => c.status !== "astro-only");
---

<table class="token-table">
  <thead>
    <tr>
      <th>Component</th>
      <th>Root class</th>
      <th>Stylesheets</th>
      <th>Docs</th>
    </tr>
  </thead>
  <tbody>
    {rows.map((c) => (
      <tr>
        <td>{c.name}</td>
        <td>
          <code>{c.root}</code>
        </td>
        <td>
          {c.styles.map((s, i) => (
            <>
              {i > 0 && " "}
              <code>{s}</code>
            </>
          ))}
        </td>
        <td>
          {c.docs && c.status === "documented" ? (
            <a href={`${base}/${c.docs}/`}>{c.name}</a>
          ) : (
            "planned"
          )}
        </td>
      </tr>
    ))}
  </tbody>
</table>
