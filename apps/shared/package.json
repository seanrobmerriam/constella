{
  "name": "@constella/shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Components, layouts, styles, config and utilities shared by the Constella apps.",
  "exports": {
    "./components/*": "./src/components/*",
    "./layouts/*": "./src/layouts/*",
    "./styles/*": "./src/styles/*",
    "./config/*": "./src/config/*",
    "./utils/*": "./src/utils/*",
    "./dist/*": "./dist/*",
    "./styles/index.css": "./src/styles/index.css",
    "./contracts/*": "./src/contracts/*"
  },
  "scripts": {
    "check": "astro check",
    "build": "bun scripts/build-css.ts"
  },
  "peerDependencies": {
    "astro": "^7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "astro": "^7.4.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.6"
  }
}
