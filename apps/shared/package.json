{
  "name": "@constella/shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Framework-independent Constella source: styles, behaviors, contracts and examples.",
  "exports": {
    "./styles/*": "./src/styles/*",
    "./dist/*": "./dist/*",
    "./styles/index.css": "./src/styles/index.css",
    "./contracts/*": "./src/contracts/*",
    "./behaviors/*": "./src/behaviors/*",
    "./examples/*": "./src/examples/*",
    "./manifest.ts": "./src/manifest.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "astro check",
    "build": "bun scripts/build-css.ts"
  },
  "peerDependencies": {
    "astro": "^7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "astro": "^7.4.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.6"
  }
}
