---
import Layout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/global/Navbar.astro";
import Footer from "@/components/global/Footer.astro";
import Section from "@/components/wrapper/Section.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import InputWrapper from "@/components/wrapper/InputWrapper.astro";
import Button from "@/components/Button.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
---

<Layout
  title="Page not found"
  description="The page you're looking for doesn't exist."
>
  <Navbar slot="header" />
  <Section paddingTop="large" paddingBottom="large" class="flex-grow">
    <ContentWrapper centered={true}>
      <Heading variant="h3" tag="h1" maxWidth={17}>
        This page doesn't exist
      </Heading>
      <Paragraph variant="large" maxWidth={36}>
        The page you're looking for may have moved, or the link that brought you
        here might be out of date.
      </Paragraph>
      <InputWrapper>
        <Button element="link" href="/">
          Back to home
        </Button>
      </InputWrapper>
    </ContentWrapper>
  </Section>
  <Footer slot="footer" />
</Layout>
