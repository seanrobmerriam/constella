---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Table from "@/components/data/Table.astro";
---

<Layout title="Data regression" noindex>
  <Section>
    <ContentWrapper>
      <Table id="first" caption="First" striped>
        <tbody>
          <tr>
            <th scope="row">A</th>
            <td class="is-numeric">1</td>
          </tr>
        </tbody>
      </Table>
      <Table id="second" caption="Second" captionHidden compact>
        <tbody>
          <tr>
            <th scope="row">B</th>
            <td>2</td>
          </tr>
        </tbody>
      </Table>
    </ContentWrapper>
  </Section>
</Layout>
