---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Alert from "@/components/feedback/Alert.astro";
---

<Layout title="Feedback regression" noindex>
  <Section>
    <ContentWrapper>
      <Alert id="plain" title="Plain">
        An info alert.
      </Alert>
      <Alert id="status" tone="success" role="status">
        Saved.
      </Alert>
      <Alert id="urgent" tone="error" role="alert" dismissible>
        Payment failed.
      </Alert>
      <Alert id="no-icon" tone="warning" icon={false}>
        No icon.
      </Alert>
      <a id="after" href="#">
        After
      </a>
    </ContentWrapper>
  </Section>
</Layout>
