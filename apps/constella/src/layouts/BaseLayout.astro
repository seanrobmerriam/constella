---
import "@/styles/global.css";
import BaseHead from "@/components/utility/BaseHead.astro";
import Skip from "@/components/global/Skip.astro";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps & {
  /** Theme for the whole page. `inherit` leaves the root defaults in place. */
  theme?: "inherit" | "light" | "dark" | "brand";
};

const { theme = "inherit", ...seo } = Astro.props;
---

<!doctype html>
<html
  lang="en"
  class:list={[theme !== "inherit" && `theme-${theme}`]}
  data-theme-locked={theme !== "inherit" ? "" : undefined}
>
  <head>
    <BaseHead {...seo} theme={theme} />
    <slot name="head" />
  </head>
  <body>
    <Skip />
    <slot name="header" />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
