---
import type { HTMLAttributes } from "astro/types";
import Heading from "@/components/typography/Heading.astro";
import Icon from "@/components/media/Icon.astro";
import arrow from "@/assets/icons/arrow.svg";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"details"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Item heading. */
  heading?: string;
  /** Heading level. */
  headingTag?: "h2" | "h3" | "h4" | "h5" | "h6";
  /** Open on load. */
  open?: boolean;
};

const {
  render = true,
  heading,
  headingTag = "h3",
  open = false,
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{render && heading && content && (
  <details
    class:list={["accordion_item", className]}
    open={open}
    data-accordion-group
    {...rest}
  >
    <summary class="accordion_toggle">
      <Heading tag={headingTag} variant="h5" class="accordion_title">
        {heading}
      </Heading>
      <Icon class="accordion_icon" src={arrow} variant="small" />
    </summary>

    <div class="accordion_body margin-trim">
      <Fragment set:html={content} />
    </div>
  </details>
)}
