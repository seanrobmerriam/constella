---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Keep only one item open. */
  single?: boolean;
  /** Open the first item on load. */
  openFirst?: boolean;
  /** Keep all items open in design mode. */
  preview?: boolean;
  /** Explicit group name shared by the items. Generated in the browser when omitted. */
  group?: string;
};

const {
  render = true,
  single = true,
  openFirst = false,
  preview = false,
  group,
  class: className,
  ...rest
} = Astro.props;
---

{render && (
  <div
    class:list={[
      "accordion_wrap",
      single && "single",
      preview && "preview",
      className,
    ]}
    data-accordion
    data-single={single ? undefined : "false"}
    data-open-first={openFirst ? "" : undefined}
    data-group={group}
    data-preview={preview ? "" : undefined}
    {...rest}
  >
    <slot />
  </div>
)}

<script>
  import { initAccordion } from "@constella/shared/behaviors/accordion.ts";

  const cleanups = new WeakMap<HTMLElement, () => void>();
  const bind = () => {
    for (const root of document.querySelectorAll<HTMLElement>(
      "[data-accordion]",
    )) {
      if (!cleanups.has(root)) cleanups.set(root, initAccordion(root));
    }
  };
  bind();
  document.addEventListener("astro:page-load", bind);
</script>
