---
import type { HTMLAttributes } from "astro/types";
import Button from "@/components/Button.astro";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Accessible label. Defaults to `Slider`. */
  label?: string;
  /** Slider bounds. */
  variant?: "bleed" | "crop-start" | "contained";
  /** Slides shown below 30rem. Defaults to `1.02`.
   *
   * @min 1
   * @max 12 */
  xsmall?: number;
  /** Slides shown from 30rem. Inherits `xsmall`.
   *
   * @min 1
   * @max 12 */
  small?: number;
  /** Slides shown from 48rem. Inherits `small`.
   *
   * @min 1
   * @max 12 */
  medium?: number;
  /** Slides shown from 64rem. Inherits `medium`.
   *
   * @min 1
   * @max 12 */
  large?: number;
};

const {
  render = true,
  label = "Slider",
  variant = "bleed",
  xsmall = 1.02,
  small,
  medium,
  large,
  class: className,
  ...rest
} = Astro.props;

const counts = { xs: xsmall, sm: small, md: medium, lg: large };

const invalid = Object.entries(counts).filter(
  ([, count]) => count !== undefined && !(Number.isFinite(count) && count > 0),
);

if (import.meta.env.DEV && invalid.length) {
  console.warn(
    `[constella] <Slider> ignores ${invalid.map(([size]) => size).join(", ")}: slides in view must be greater than 0.`,
  );
}

const set = (count: number | undefined) =>
  count !== undefined && Number.isFinite(count) && count > 0;

const visible =
  [
    xsmall !== 1.02 && set(xsmall) && `--_visible-xs: ${xsmall}`,
    set(small) && `--_visible-sm: ${small}`,
    set(medium) && `--_visible-md: ${medium}`,
    set(large) && `--_visible-lg: ${large}`,
  ]
    .filter(Boolean)
    .join("; ") || undefined;

const slides = await slotContent(Astro.slots);
---

{render && slides && (
  <div
    class:list={["slider_wrap", variant !== "bleed" && variant, className]}
    style={visible}
    {...rest}
  >
    <div class="slider_list" role="group" aria-label={label} tabindex="0">
      <Fragment set:html={slides} />
    </div>

    <div class="slider_controls">
      <div class="slider_markers" />
      <div class="slider_steps">
        <Button
          variant="arrow"
          emphasis="secondary"
          direction="back"
          label="Previous slide"
          data-step="-1"
        />
        <Button
          variant="arrow"
          emphasis="secondary"
          label="Next slide"
          data-step="1"
        />
      </div>
    </div>
  </div>
)}

<script>
  import { initSlider } from "@constella/shared/behaviors/slider.ts";

  const cleanups = new WeakMap<HTMLElement, () => void>();
  const bind = () => {
    for (const root of document.querySelectorAll<HTMLElement>(".slider_wrap")) {
      if (!cleanups.has(root)) cleanups.set(root, initSlider(root));
    }
  };
  bind();
  document.addEventListener("astro:page-load", bind);
</script>
