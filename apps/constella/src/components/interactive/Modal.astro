---
import type { HTMLAttributes } from "astro/types";
import Button from "@/components/Button.astro";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"dialog"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Modal ID for triggers, hash links, and `?modal=`. Required. */
  id?: string;
  /** Accessible label. */
  label?: string;
  /** Modal style. */
  variant?: "small" | "side-panel" | "full-screen";
  /** Keep open in design mode. */
  preview?: boolean;
};

const {
  render = true,
  id,
  label,
  variant = "small",
  preview = false,
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);

if (import.meta.env.DEV && render && content && !id) {
  console.warn(
    "[constella] <Modal> rendered without an `id`, so nothing could open it and nothing was output.",
  );
}
---

{render && id && content && (
  <dialog
    id={id}
    class:list={[
      "modal_wrap",
      variant !== "small" && variant,
      preview && "preview",
      className,
    ]}
    aria-label={label}
    {...rest}
  >
    <div class="modal_content">
      <Button
        class="modal_close"
        variant="close"
        emphasis="secondary"
        data-modal-close
      />
      <div class="modal_scroll" data-modal-scroll>
        <div class="modal_body margin-trim">
          <Fragment set:html={content} />
        </div>
      </div>
    </div>
  </dialog>
)}

<script>
  import { initModal } from "@constella/shared/behaviors/modal.ts";

  const cleanups = new WeakMap<HTMLElement, () => void>();
  const bind = () => {
    for (const root of document.querySelectorAll<HTMLDialogElement>(
      ".modal_wrap",
    )) {
      if (!cleanups.has(root)) cleanups.set(root, initModal(root));
    }
  };
  bind();
  document.addEventListener("astro:page-load", bind);
</script>
