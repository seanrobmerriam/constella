---
import type { HTMLAttributes } from "astro/types";
import type {
  ControlSize,
  ControlRadius,
} from "@constella/shared/contracts/controls.ts";
import Icon from "@/components/media/Icon.astro";
import arrow from "@/assets/icons/arrow.svg";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Trigger text. */
  label?: string;
  /** Keep the panel open in design mode. */
  preview?: boolean;
  /** Opt-in control size. Omit to keep the default. */
  size?: ControlSize;
  /** Opt-in corner radius. Omit to keep the default. */
  radius?: ControlRadius;
};

const {
  render = true,
  label,
  preview = false,
  size,
  radius,
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{render && label && content && (
  <details
    class:list={["dropdown_wrap", preview && "preview", className]}
    data-size={size}
    data-radius={radius}
    {...rest}
  >
    <summary class="dropdown_toggle">
      <span class="dropdown_label text-style-trim">{label}</span>
      <Icon class="dropdown_icon" src={arrow} variant="small" />
    </summary>

    <div class="dropdown_content">
      <div class="dropdown_body margin-trim">
        <Fragment set:html={content} />
      </div>
    </div>
  </details>
)}

<script>
  import { initDropdown } from "@constella/shared/behaviors/dropdown.ts";

  const cleanups = new WeakMap<HTMLElement, () => void>();
  const bind = () => {
    for (const root of document.querySelectorAll<HTMLDetailsElement>(
      ".dropdown_wrap",
    )) {
      if (!cleanups.has(root)) cleanups.set(root, initDropdown(root));
    }
  };
  bind();
  document.addEventListener("astro:page-load", bind);
</script>
