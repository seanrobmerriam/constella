---
import type { HTMLAttributes } from "astro/types";
import Button from "@/components/Button.astro";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Tab layout. */
  variant?: "horizontal" | "side";
  /** Panel playback. */
  playback?: "manual" | "auto";
  /** Show all panels in design mode. */
  preview?: boolean;
};

const {
  render = true,
  variant = "horizontal",
  playback = "manual",
  preview = false,
  class: className,
  ...rest
} = Astro.props;

const auto = playback === "auto";

const links = await slotContent(Astro.slots, "links");
const panels = await slotContent(Astro.slots);
---

{render && links && panels && (
  <div
    class:list={[
      "tabs_wrap",
      variant !== "horizontal" && variant,
      auto && "auto",
      preview && "preview",
      className,
    ]}
    {...rest}
  >
    <div class="tabs_bar">
      <div
        class="tabs_links"
        role="tablist"
        aria-orientation={variant === "side" ? "vertical" : "horizontal"}
      >
        <Fragment set:html={links} />
      </div>
    </div>

    <div class="tabs_panels">
      <Fragment set:html={panels} />
    </div>

    {auto && (
      <div class="tabs_controls">
        <div class="tabs_steps">
          <Button
            variant="arrow"
            emphasis="secondary"
            direction="back"
            label="Previous tab"
            data-step="-1"
          />
          <Button
            variant="arrow"
            emphasis="secondary"
            label="Next tab"
            data-step="1"
          />
        </div>
        <Button
          variant="play"
          emphasis="secondary"
          label="Pause automatic rotation"
          pressed
          data-toggle
        />
      </div>
    )}
  </div>
)}

{}
<noscript>
  <style>
    .tabs_bar,
    .tabs_controls {
      display: none;
    }
    .tabs_wrap {
      grid-template-columns: none;
    }
    .tabs_panels {
      gap: var(--space-6);
      overflow: visible;
    }
    .tabs_panels > * {
      grid-area: auto;
      opacity: 1;
      visibility: visible;
      translate: none;
    }
  </style>
</noscript>

<script>
  import { initTabs } from "@constella/shared/behaviors/tabs.ts";

  const cleanups = new WeakMap<HTMLElement, () => void>();
  const bind = () => {
    for (const root of document.querySelectorAll<HTMLElement>(".tabs_wrap")) {
      if (!cleanups.has(root)) cleanups.set(root, initTabs(root));
    }
  };
  bind();
  document.addEventListener("astro:page-load", bind);
</script>
