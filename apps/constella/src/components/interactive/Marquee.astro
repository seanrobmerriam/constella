---
import type { HTMLAttributes } from "astro/types";
import Button from "@/components/Button.astro";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Accessible label. Defaults to `Marquee`. */
  label?: string;
  /** Travel direction. */
  direction?: "forwards" | "backwards";
};

const {
  render = true,
  label = "Marquee",
  direction = "forwards",
  class: className,
  ...rest
} = Astro.props;

const items = await slotContent(Astro.slots);

/**
 * Elements at the top of the slot, counted so the animation can scale with
 * them. Depth is tracked because only the outermost elements are items, and
 * the ones that never close are skipped rather than left holding the count
 * open. Comments are already stripped by `slotContent`.
 */
const VOID = new Set([
  "area",
  "base",
  "br",
  "col",
  "embed",
  "hr",
  "img",
  "input",
  "link",
  "meta",
  "param",
  "source",
  "track",
  "wbr",
]);

const countItems = (html: string) => {
  let depth = 0;
  let count = 0;
  for (const [, closing, name, , selfClosing] of html.matchAll(
    /<(\/?)([a-zA-Z][^\s/>]*)([^>]*?)(\/?)>/g,
  )) {
    if (closing) {
      depth = Math.max(0, depth - 1);
      continue;
    }
    if (depth === 0) count += 1;
    if (!selfClosing && !VOID.has(name.toLowerCase())) depth += 1;
  }
  return count;
};

const count = countItems(items);

/* The one thing the stylesheet cannot work out for itself. The pace it is
   multiplied by is set there, beside the rest of the animation. */
const locals = `--_count: ${count}`;
---

{render && items && (
  <div
    class:list={[
      "marquee_wrap",
      direction !== "forwards" && direction,
      className,
    ]}
    style={locals}
    role="group"
    aria-label={label}
    {...rest}
  >
    <div class="marquee_viewport">
      <div class="marquee_track">
        <div class="marquee_panel">
          <Fragment set:html={items} />
        </div>
        {/* The copy that carries the loop. Astro renders it, so the strip is
            whole before any script runs, and it is held out of the accessibility
            tree and the tab order so nothing here is met twice. */}
        <div class="marquee_panel" aria-hidden="true" inert>
          <Fragment set:html={items} />
        </div>
      </div>
    </div>

    <Button
      variant="play"
      emphasis="secondary"
      pressed={true}
      class="marquee_toggle"
      data-marquee-toggle
    />
  </div>
)}

<script>
  for (const marquee of document.querySelectorAll<HTMLElement>(
    ".marquee_wrap",
  )) {
    const toggle = marquee.querySelector<HTMLButtonElement>(
      "[data-marquee-toggle]",
    );
    if (!toggle) continue;

    const reduced = matchMedia("(prefers-reduced-motion: reduce)");

    const setPlaying = (playing: boolean) => {
      marquee.dataset.state = playing ? "playing" : "paused";
      toggle.setAttribute("aria-pressed", String(playing));
      toggle.setAttribute("aria-label", playing ? "Pause" : "Play");
    };

    /* Anyone who asked for less motion gets it still, and can start it. */
    setPlaying(!reduced.matches);
    reduced.addEventListener("change", () => setPlaying(!reduced.matches));

    toggle.addEventListener("click", () => {
      setPlaying(marquee.dataset.state !== "playing");
    });
  }
</script>
