---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type ContentWrapperVariant =
  | "stack"
  | "auto-width"
  | "columns"
  | "breakout"
  | "contain"
  | "sticky-content"
  | "sticky-visual"
  | "card";

type Base = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Content layout. */
  variant?: ContentWrapperVariant;
};

type ColumnClasses = {
  /** First-column classes. */
  column1Class?: string;
  /** Second-column classes. */
  column2Class?: string;
};

type Props = Base &
  (
    | {
        variant?: "stack";
        reverse?: never;
        /** Center each column's content. */
        centered?: boolean;
        mediaOpacity?: never;
      }
    | {
        variant: "auto-width";
        reverse?: never;
        centered?: never;
        mediaOpacity?: never;
      }
    | {
        variant: "columns" | "breakout" | "contain";
        /** Show the second column first. */
        reverse?: boolean;
        centered?: never;
        mediaOpacity?: never;
      }
    | {
        variant: "sticky-content" | "sticky-visual";
        reverse?: never;
        centered?: never;
        mediaOpacity?: never;
      }
    | {
        variant: "card";
        reverse?: never;
        centered?: never;
        /**
         * Card visual opacity. Defaults to `70`.
         *
         * @min 0
         * @max 100
         * @int
         */
        mediaOpacity?: number;
      }
  ) &
  ColumnClasses;

type AllProps = Base &
  ColumnClasses & {
    variant?: ContentWrapperVariant;
    reverse?: boolean;
    centered?: boolean;
    mediaOpacity?: number;
  };

const {
  render = true,
  variant = "stack",
  reverse = false,
  centered = false,
  mediaOpacity,
  column1Class,
  column2Class,
  class: className,
  ...rest
} = Astro.props as AllProps;

const validMediaOpacity =
  mediaOpacity !== undefined &&
  Number.isFinite(mediaOpacity) &&
  mediaOpacity >= 0 &&
  mediaOpacity <= 100;

if (import.meta.env.DEV && mediaOpacity !== undefined) {
  if (!validMediaOpacity) {
    console.warn(
      `[constella] <ContentWrapper mediaOpacity={${mediaOpacity}}> must be between 0 and 100; the default is used instead.`,
    );
  } else if (variant !== "card") {
    console.warn(
      `[constella] <ContentWrapper variant="${variant}"> ignores mediaOpacity; only the card variant has a visual to fade.`,
    );
  }
}

const media =
  variant === "card" && validMediaOpacity && mediaOpacity !== 70
    ? `--_media-opacity: ${mediaOpacity}`
    : undefined;

const variantClasses =
  variant === "stack"
    ? []
    : variant === "card"
      ? ["card-layout", "theme-dark"]
      : [variant];

const column1 = await slotContent(Astro.slots);
const column2 = await slotContent(Astro.slots, "column2");
---

{render && (column1 || column2) && (
  <div
    class:list={[
      "layout",
      variantClasses,
      reverse && "reversed",
      centered && "centered",
      className,
    ]}
    style={media}
    {...rest}
  >
    {column1 && (
      <div class:list={[column1Class]}>
        <Fragment set:html={column1} />
      </div>
    )}
    {column2 && (
      <div class:list={[column2Class]}>
        <Fragment set:html={column2} />
      </div>
    )}
  </div>
)}
