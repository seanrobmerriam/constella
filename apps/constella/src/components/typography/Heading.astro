---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type HeadingStyle =
  | "inherit"
  | "display"
  | "h1"
  | "h2"
  | "h3"
  | "h4"
  | "h5"
  | "h6"
  | "large"
  | "main"
  | "small"
  | "eyebrow"
  | "eyebrow-tag";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** HTML element. Defaults to `h2`, or `p` for the eyebrow variants. */
  tag?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "p" | "span";
  /** Type style. */
  variant?: HeadingStyle;
  /**
   * Maximum line length in characters.
   *
   * @min 1
   * @int
   */
  maxWidth?: number;
}

const {
  render = true,
  tag,
  variant: given,
  maxWidth,
  class: className,
  ...rest
} = Astro.props;

const isEyebrow = given === "eyebrow" || given === "eyebrow-tag";
const Tag = tag ?? (isEyebrow ? "p" : "h2");
const variant = given ?? (Tag === "p" || Tag === "span" ? "inherit" : Tag);
const style = isEyebrow ? "small" : variant;

const content = await slotContent(Astro.slots);
---

{render && content && (
  <Tag
    class:list={[
      "heading",
      isEyebrow && given,
      style !== "inherit" && `text-style-${style}`,
      className,
    ]}
    style={maxWidth ? `--_mw: ${maxWidth}ch;` : undefined}
    {...rest}
  >
    <Fragment set:html={content} />
  </Tag>
)}
