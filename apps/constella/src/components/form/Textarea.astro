---
import type { HTMLAttributes } from "astro/types";
import type {
  ControlRadius,
  ControlSize,
} from "@constella/shared/contracts/controls.ts";
import { slug } from "@/utils/slug.ts";

interface Props extends Omit<HTMLAttributes<"textarea">, "rows"> {
  /** Opt-in control size. Omit to keep the default. */
  size?: ControlSize;
  /** Opt-in corner radius. Omit to keep the default. */
  radius?: ControlRadius;
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Field label. */
  label?: string;
  /** Initial value. */
  value?: string;
  /** Submitted name. Defaults to the label slug. */
  name?: string;
  /** Empty-field hint. */
  placeholder?: string;
  /** Minimum visible lines. Defaults to `3`.
   *
   * @min 1
   * @int */
  minLines?: number;
  /** Maximum visible lines. Defaults to `12`.
   *
   * @min 1
   * @int */
  maxLines?: number;
  /** Require the field and mark its label. */
  required?: boolean;
}

const {
  render = true,
  label,
  value,
  name,
  placeholder,
  minLines = 3,
  maxLines = 12,
  required = false,
  size,
  radius,
  class: className,
  ...rest
} = Astro.props;
---

{render && label && (
  <label
    class:list={["field", "form-textarea", className]}
    data-size={size}
    data-radius={radius}
    style={`--_min-lines: ${minLines}; --_max-lines: ${maxLines};`}
  >
    <span class="field-label text-style-main">
      <span>{label}</span>
      {required && (
        <span class="field-star" aria-hidden="true">
          *
        </span>
      )}
    </span>
    <textarea
      class="field-control form-textarea_field text-style-main"
      name={name ?? slug(label)}
      placeholder={placeholder}
      required={required || undefined}
      rows={minLines}
      {...rest}
      set:text={value}
    />
  </label>
)}
