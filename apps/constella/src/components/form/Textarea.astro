---
import type { HTMLAttributes } from "astro/types";
import type {
  ControlRadius,
  ControlSize,
} from "@constella/shared/contracts/controls.ts";
import { slug } from "@/utils/slug.ts";
import { fieldMessages } from "@/utils/field.ts";
import Field from "@/components/form/Field.astro";

interface Props extends Omit<HTMLAttributes<"textarea">, "rows"> {
  /** Opt-in control size. Omit to keep the default. */
  size?: ControlSize;
  /** Opt-in corner radius. Omit to keep the default. */
  radius?: ControlRadius;
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Field label. */
  label?: string;
  /** Initial value. */
  value?: string;
  /** Submitted name. Defaults to the label slug. */
  name?: string;
  /** Empty-field hint. */
  placeholder?: string;
  /** Minimum visible lines. Defaults to `3`.
   *
   * @min 1
   * @int */
  minLines?: number;
  /** Maximum visible lines. Defaults to `12`.
   *
   * @min 1
   * @int */
  maxLines?: number;
  /** Require the field and mark its label. */
  required?: boolean;
  /** Help text under the field, linked with aria-describedby. */
  help?: string;
  /** Error text under the field. Also marks the control aria-invalid. */
  error?: string;
}

const {
  render = true,
  label,
  value,
  name,
  placeholder,
  minLines = 3,
  maxLines = 12,
  required = false,
  help,
  error,
  size,
  radius,
  class: className,
  id,
  ...rest
} = Astro.props;

const messages = fieldMessages({ id, help, error });
---

{render && label && (
  <Field
    class={["form-textarea", className]}
    size={size}
    radius={radius}
    style={`--_min-lines: ${minLines}; --_max-lines: ${maxLines};`}
    label={label}
    required={required}
    controlId={messages.controlId}
    help={help}
    helpId={messages.helpId}
    error={error}
    errorId={messages.errorId}
  >
    <textarea
      class="field-control form-textarea_field text-style-main"
      id={messages.controlId}
      name={name ?? slug(label)}
      placeholder={placeholder}
      required={required || undefined}
      rows={minLines}
      aria-describedby={messages.describedBy}
      aria-invalid={messages.invalid}
      {...rest}
      set:text={value}
    />
  </Field>
)}
