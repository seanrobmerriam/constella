---
import type { HTMLAttributes } from "astro/types";
import Icon from "@/components/media/Icon.astro";
import check from "@/assets/icons/check.svg";
import { slug } from "@/utils/slug.ts";

type Base = {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Control label. */
  label?: string;
  /** Submitted value. Defaults to `on`. */
  value?: string;
};

type Kind =
  | {
      /** Input type. */
      type?: "checkbox";
      /** Submitted name. Defaults to the label slug. */
      name?: string;
    }
  | {
      /** Input type. */
      type: "radio";
      /** Shared name for the radio group. */
      name: string;
    };

type Settings = {
  /** Control style. */
  variant?: "default" | "toggle" | "chip";
  /** Start selected. */
  checked?: boolean;
  /** Require a selection. */
  required?: boolean;
};

type Props = Omit<HTMLAttributes<"input">, "type" | "value"> &
  Base &
  Kind &
  Settings;

type AllProps = Omit<HTMLAttributes<"input">, "type" | "value"> &
  Base & { type?: "checkbox" | "radio"; name?: string } & Settings;

const {
  render = true,
  label,
  value,
  type = "checkbox",
  name,
  variant = "default",
  checked = false,
  required = false,
  class: className,
  ...rest
} = Astro.props as AllProps;
---

{render && label && (
  <label
    class:list={["form-choice", variant !== "default" && variant, className]}
  >
    <input
      class="form-choice_input"
      type={type}
      name={name ?? slug(label)}
      value={value}
      checked={checked || undefined}
      required={required || undefined}
      {...rest}
    />
    <span class="form-choice_mark" aria-hidden="true">
      {type === "radio" ? (
        <span class="form-choice_dot" />
      ) : (
        <Icon class="form-choice_tick" src={check} variant="small" />
      )}
    </span>
    <span class="form-choice_text text-style-main">{label}</span>
  </label>
)}
