---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

interface Props extends HTMLAttributes<"form"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Form name. */
  name?: string;
  /** Form endpoint. Omit to skip submission. */
  action?: string;
  /** Message shown after submission. */
  successMessage?: string;
  /** Message shown after an error. */
  errorMessage?: string;
}

const {
  render = true,
  name,
  action,
  successMessage = "Thanks — we will be in touch.",
  errorMessage = "That did not send. Please try again.",
  method = "post",
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{render && name && content && (
  <div
    class:list={["form_wrap", className]}
    data-state="idle"
    data-endpoint={action}
  >
    <form
      class="form_fields"
      name={name}
      action={action}
      method={method}
      {...rest}
    >
      <Fragment set:html={content} />
    </form>

    <p class="form_note form_note-sent text-style-main" role="status">
      {successMessage}
    </p>
    <p class="form_note form_note-failed text-style-main" role="alert">
      {errorMessage}
    </p>
  </div>
)}

<script>
  import { initForm } from "@constella/shared/behaviors/form.ts";

  const cleanups = new WeakMap<HTMLElement, () => void>();
  const bind = () => {
    for (const root of document.querySelectorAll<HTMLElement>(".form_wrap")) {
      if (!cleanups.has(root)) cleanups.set(root, initForm(root));
    }
  };
  bind();
  document.addEventListener("astro:page-load", bind);
</script>
