---
import Button from "@/components/Button.astro";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Target ID, without `#`. */
  target?: string;
  /** Link text. */
  label?: string;
}

const {
  render = true,
  target = "main",
  label = "Skip to main content",
} = Astro.props;
---

{render && (
  <Button element="link" href={`#${target}`} class="skip-link">
    {label}
  </Button>
)}
