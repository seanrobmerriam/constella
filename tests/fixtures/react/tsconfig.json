{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["react", "react-dom"],
    "paths": {
      "constella/behaviors/*": ["../../../apps/shared/src/behaviors/*.ts"]
    }
  },
  "include": ["../../../apps/shared/src/examples/**/*.tsx", "render.tsx"]
}
